{
  "name": "claude-chats-web",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight local web UI to list and run claude-chats sessions in the browser (wraps the real claude CLI via a PTY).",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  }
}
